# Root-level env for docker-compose. Copy to .env and fill in. NEVER commit .env.

# Strong random secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the extraction model (claude-opus-4-8 | claude-sonnet-5 | claude-haiku-4-5)
ANTHROPIC_MODEL=claude-opus-4-8
