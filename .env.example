# Root-level env for docker-compose. Copy to .env and fill in. NEVER commit .env.

# Strong random secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- LLM provider: "openai" (any OpenAI-compatible endpoint), "anthropic",
#     "gemini", or "offline" (local OCR, no API key) ---
LLM_PROVIDER=openai

# OpenAI-compatible endpoint. The model MUST be vision-capable — a text-only
# model cannot read document images.
#
# Default: NVIDIA's hosted DiffusionGemma (multimodal; does OCR + document
# understanding). Get a key at https://build.nvidia.com — it is shown only once.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=google/diffusiongemma-26b-a4b-it
LLM_API_KEY=nvapi-...
# Self-hosted Ollama alternative (the old SIH GPU box is dead — repoint it):
#   LLM_BASE_URL=http://<your-ollama-host>:11434/v1
#   LLM_MODEL=qwen2.5vl:32b
#   LLM_API_KEY=ollama

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Only needed when LLM_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Only when LLM_PROVIDER=offline: local OCR, no API key, no GPU ---
# tesseract (default, tiny) | surya (Surya OCR 2, far more accurate on scans)
OCR_ENGINE=tesseract
# For OCR_ENGINE=surya — see backend/requirements-surya.txt for the install.
# Surya 0.21 drives an external llama.cpp server; give it the binary path.
TORCH_DEVICE=cpu
#LLAMA_CPP_BINARY=/abs/path/to/vendor/llama-b10048/llama-server
