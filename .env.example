# Root-level env for docker-compose. Copy to .env and fill in. NEVER commit .env.

# Strong random secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- LLM provider: "openai" (OpenAI-compatible / self-hosted Ollama) or "anthropic" ---
LLM_PROVIDER=openai

# OpenAI-compatible endpoint. Model MUST be vision-capable (e.g. qwen2.5vl) —
# a text-only model like qwen3-coder:30b cannot read document images.
LLM_BASE_URL=http://135.13.20.57:11434/v1
LLM_MODEL=qwen2.5vl:32b
LLM_API_KEY=ollama

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
