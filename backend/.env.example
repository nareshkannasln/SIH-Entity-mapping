# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=docverify

# --- Auth ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=60

# --- Bootstrap admin (created on first startup if missing) ---
# Log in with ADMIN_USERNAME / ADMIN_PASSWORD, then change the password from the
# Profile page. CHANGE THESE before any real deployment.
ADMIN_USERNAME=admin@docverify
ADMIN_EMAIL=admin@docverify.com
ADMIN_PASSWORD=admin@123

# --- LLM / extraction ---
# Provider:
#   "offline"    — built-in Tesseract OCR + NER engine (no API key, no GPU) [default]
#   "gemini"     — Google Gemini (generous free tier)
#   "groq"       — Groq (free tier, very fast)
#   "openrouter" — OpenRouter free vision models
#   "openai"     — any OpenAI-compatible endpoint (e.g. self-hosted Ollama)
#   "anthropic"  — Claude
# All cloud providers can also be selected/keyed at runtime on the Settings page.
LLM_PROVIDER=offline

# Offline engine (used when LLM_PROVIDER=offline). Needs the tesseract-ocr system
# package and the spaCy model (both installed by the backend Dockerfile).
OCR_LANGUAGES=eng
SPACY_MODEL=en_core_web_sm

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai).
# The model MUST be vision-capable (qwen2.5vl, llama3.2-vision, minicpm-v, ...).
# A text-only model like qwen3-coder:30b CANNOT read document images.
LLM_BASE_URL=http://135.13.20.57:11434/v1
LLM_MODEL=qwen2.5vl:32b
LLM_API_KEY=ollama

# Anthropic (used when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Gemini (used when LLM_PROVIDER=gemini). Free key at https://aistudio.google.com/apikey
# The model MUST be vision-capable (gemini-2.5-flash, gemini-2.5-pro, ...).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (used when LLM_PROVIDER=groq). Free key at https://console.groq.com/keys
# The model MUST be vision-capable (e.g. a Llama 4 / Llama Vision model).
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter (used when LLM_PROVIDER=openrouter). Free key at https://openrouter.ai/keys
# Use a vision-capable model; ":free" variants cost nothing (but are rate-limited).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# --- CORS (comma-separated origins the SPA is served from) ---
CORS_ORIGINS=http://localhost:5173
