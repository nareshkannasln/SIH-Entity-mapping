# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=docverify

# --- Auth ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=60

# --- LLM / extraction ---
# Provider: "openai" (any OpenAI-compatible endpoint, e.g. self-hosted Ollama)
#           or "anthropic" (Claude).
LLM_PROVIDER=openai

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai).
# The model MUST be vision-capable (qwen2.5vl, llama3.2-vision, minicpm-v, ...).
# A text-only model like qwen3-coder:30b CANNOT read document images.
LLM_BASE_URL=http://135.13.20.57:11434/v1
LLM_MODEL=qwen2.5vl:32b
LLM_API_KEY=ollama

# Anthropic (used when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- CORS (comma-separated origins the SPA is served from) ---
CORS_ORIGINS=http://localhost:5173
